# Prisma Postgres / PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/enorsis?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public application URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Development-only credentials used until database-backed onboarding is enabled.
# Do not reuse these values in production.
ENORSIS_ADMIN_EMAIL="admin@enorsis.local"
ENORSIS_ADMIN_PASSWORD="change-me-before-use"
ENORSIS_ADMIN_NAME="Platform Administrator"

# Initial tenant attached to the development administrator session.
ENORSIS_DEMO_TENANT_ID="tenant_northstar"
ENORSIS_DEMO_TENANT_SLUG="northstar-global"
ENORSIS_DEMO_TENANT_NAME="Northstar Global"

# Connected private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=""
