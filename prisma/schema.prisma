  COMPLETED
  REMOVED
}

enum SourcingRoundStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum SourcingAwardStatus {
  DRAFT
  RECOMMENDED
  APPROVED
  REJECTED
}

enum SourcingEventType {
