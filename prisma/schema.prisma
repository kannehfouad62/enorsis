  RFQ
  RFP
}

enum SourcingEventStatus {
  DRAFT
  PUBLISHED
  OPEN
  EVALUATION
  AWARDED
  CANCELLED
  CLOSED
}

enum SourcingInvitationStatus {
  INVITED
  VIEWED
  DECLINED
  SUBMITTED
}

enum SourcingResponseStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
