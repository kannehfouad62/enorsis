  children         Department[]      @relation("DepartmentHierarchy")
  purchaseRequests PurchaseRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([legalEntityId])
  @@index([siteId])
  @@index([parentId])
}

model ExchangeRate {
