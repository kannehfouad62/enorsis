  contacts                 SupplierContact[]
  documents                SupplierDocument[]
  sourcingInvitations      SourcingInvitation[]
  sourcingResponses        SourcingResponse[]
  supplierClaims           SupplierClaim[]
  esgProfile               SupplierEsgProfile?
  portalInvitations        SupplierPortalInvitation[]
  portalUsers              SupplierPortalUser[]
  onboardingQuestionnaires SupplierOnboardingQuestionnaire[]
  portalTasks              SupplierPortalTask[]
  portalMessages           SupplierPortalMessage[]
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  sourcingQuestions        SourcingQuestion[]
  contracts                Contract[]
  riskAssessments          SupplierRiskAssessment[]
  riskFindings             SupplierRiskFinding[]
  esgAssessments           SupplierEsgAssessment[]
  purchaseOrders           PurchaseOrder[]
  supplierInvoices         SupplierInvoice[]
  scorecards               SupplierScorecard[]
  developmentPlans         SupplierDevelopmentPlan[]
  correctiveActions        SupplierCorrectiveAction[]

  procurementCatalogs ProcurementCatalog[]

  statementsOfWork StatementOfWork[]

  @@unique([tenantId, supplierNumber])
  @@unique([tenantId, legalName, countryCode])
  @@index([tenantId, status])
  @@index([tenantId, riskTier])
  @@index([tenantId, qualificationStatus])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
