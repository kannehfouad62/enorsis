generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AiExecutionStatus {
  PENDING
  COMPLETED
  FAILED
  REJECTED
}

enum AiReviewStatus {
  NOT_REQUIRED
  PENDING
  ACCEPTED
  REJECTED
}

enum AiCapability {
  PROCUREMENT_COPILOT
  RFX_DRAFT
  SUPPLIER_ANALYSIS
  CONTRACT_REVIEW
  NEGOTIATION_ADVISOR
  SPEND_ANALYSIS
  RISK_BRIEF
  EXECUTIVE_BRIEF
}

enum ContractAmendmentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  EXECUTED
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

