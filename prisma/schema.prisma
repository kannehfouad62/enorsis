  SERVICE
}

enum ReceiptStatus {
  DRAFT
  POSTED
  REVERSED
}

enum SupplierInvoiceStatus {
  DRAFT
  SUBMITTED
  MATCHING
  EXCEPTION
  APPROVED
  PAYMENT_READY
  PAID
  REJECTED
  CANCELLED
}

enum InvoiceMatchStatus {
  NOT_MATCHED
  MATCHED
  EXCEPTION
  OVERRIDDEN
}

enum MatchExceptionType {
  QUANTITY
  PRICE
  TAX
  CURRENCY
  MISSING_RECEIPT
  MISSING_PURCHASE_ORDER
  DUPLICATE_INVOICE
  OTHER
}

enum PaymentBatchStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EXPORTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentBatchItemStatus {
  PENDING
  INCLUDED
  REJECTED
  PAID
  FAILED
}

enum MatchExceptionStatus {
  OPEN
  RESOLVED
  OVERRIDDEN
}

enum PurchaseRequestPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PlatformRole {
  PLATFORM_SUPER_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_AUDITOR

  TENANT_OWNER
  TENANT_ADMIN

  PROCUREMENT_EXECUTIVE
  PROCUREMENT_MANAGER
  BUYER
  REQUESTER
  APPROVER

  FINANCE
  ACCOUNTS_PAYABLE
  LEGAL
  RISK_COMPLIANCE
  SUPPLIER_MANAGER

  AUDITOR
  VIEWER
}

enum CurrencyPolicyMode {
  USD_ONLY
  USD_WITH_LOCAL_DISPLAY
  TENANT_BASE_CURRENCY
}

enum ExchangeRateSource {
  MANUAL
  ECB
  FEDERAL_RESERVE
  OPEN_EXCHANGE_RATES
  OTHER
}

enum LegalEntityStatus {
  ACTIVE
  INACTIVE
  DISSOLVED
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum IntegrationProvider {
  SAP
  ORACLE
  MICROSOFT_DYNAMICS
  NETSUITE
  WORKDAY
  COUPA
  ARIBA
  GENERIC_REST
  GENERIC_SFTP
  GENERIC_WEBHOOK
  OTHER
}

enum IntegrationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
  RETIRED
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

enum IntegrationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum IntegrationEventStatus {
  RECEIVED
  VALIDATED
  PROCESSED
  REJECTED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  AI_AGENT
  INTEGRATION
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
  PARTIAL
}

enum AiAgentTaskStatus {
  DRAFT
  QUEUED
  WAITING_APPROVAL
  APPROVED
  RUNNING
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum AiAgentTaskType {
  SUPPLIER_DUE_DILIGENCE
  RFX_DRAFT
  NEGOTIATION_PLAN
  CONTRACT_REVIEW
  SPEND_OPPORTUNITY
  RISK_MONITORING
  EXECUTIVE_BRIEF
  INVOICE_EXCEPTION_ANALYSIS
}

enum AiAgentApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum AiAgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  RETIRED
}

enum AiAutonomyLevel {
  ADVISORY
  DRAFT_ONLY
  HUMAN_APPROVAL_REQUIRED
  POLICY_BOUND_AUTONOMOUS
}

model User {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  passwordHash        String?
  passwordChangedAt   DateTime?
  mustChangePassword  Boolean                   @default(false)
  sessionVersion      Int                       @default(1)
  passwordResetTokens PasswordResetToken[]
  purchaseRequests    PurchaseRequest[]         @relation("PurchaseRequestRequester")
  approvalDecisions   PurchaseRequestApproval[] @relation("PurchaseRequestApprover")
  locale              String                    @default("en-US")
  timeZone            String                    @default("UTC")
  isActive            Boolean                   @default(true)
  memberships         Membership[]
  auditEvents         AuditEvent[]              @relation("AuditEventUser")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([isActive])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Tenant {
  id                   String                  @id @default(cuid())
  slug                 String                  @unique
  name                 String
  legalName            String?
  status               TenantStatus            @default(PROVISIONING)
  countryCode          String?
  defaultLocale        String                  @default("en-US")
  defaultTimeZone      String                  @default("UTC")
  currencyPolicyMode   CurrencyPolicyMode      @default(USD_ONLY)
  baseCurrencyCode     String                  @default("USD")
  localDisplayCurrency String?
  usdReportingEnabled  Boolean                 @default(true)
  memberships          Membership[]
  legalEntities        LegalEntity[]
  sites                Site[]
  departments          Department[]
  exchangeRates        ExchangeRate[]
  auditEvents          AuditEvent[]
  aiAgents             AiAgent[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  receipts             ProcurementReceipt[]
  supplierInvoices     SupplierInvoice[]
  suppliers            Supplier[]
  sourcingEvents       SourcingEvent[]
  paymentBatches       PaymentBatch[]
  integrations         IntegrationConnection[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  archivedAt           DateTime?
  contracts            Contract[]
  clauseTemplates      ClauseTemplate[]
  aiAgentTasks         AiAgentTask[]

  @@index([status])
  @@index([countryCode])
}

model Membership {
  id                  String           @id @default(cuid())
  tenantId            String
  userId              String
  status              MembershipStatus @default(INVITED)
  roles               PlatformRole[]
  jobTitle            String?
  employeeId          String?
  approvalLimitUsd    Decimal?         @db.Decimal(18, 2)
  legalEntityScopeIds String[]         @default([])
  siteScopeIds        String[]         @default([])
  departmentScopeIds  String[]         @default([])
  invitedByUserId     String?
  invitedAt           DateTime         @default(now())
  activatedAt         DateTime?
  lastActiveAt        DateTime?
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId, status])
}

model LegalEntity {
  id                  String            @id @default(cuid())
  tenantId            String
  name                String
  legalName           String
  registrationNumber  String?
  taxIdentificationNo String?
  countryCode         String
  baseCurrencyCode    String
  status              LegalEntityStatus @default(ACTIVE)
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sites               Site[]
  departments         Department[]
  purchaseRequests    PurchaseRequest[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([tenantId, legalName, countryCode])
  @@index([tenantId, status])
}

model Site {
  id               String            @id @default(cuid())
  tenantId         String
  legalEntityId    String?
  code             String
  name             String
  countryCode      String
  region           String?
  city             String?
  addressLine1     String?
  addressLine2     String?
  postalCode       String?
  timeZone         String            @default("UTC")
  status           SiteStatus        @default(ACTIVE)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity      LegalEntity?      @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  departments      Department[]
  purchaseRequests PurchaseRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([legalEntityId])
}

model Department {
  id               String            @id @default(cuid())
  tenantId         String
  legalEntityId    String?
  siteId           String?
  code             String
  name             String
  parentId         String?
  isActive         Boolean           @default(true)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity      LegalEntity?      @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  site             Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  parent           Department?       @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Department[]      @relation("DepartmentHierarchy")
  purchaseRequests PurchaseRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([legalEntityId])
  @@index([siteId])
  @@index([parentId])
}

model ExchangeRate {
  id              String             @id @default(cuid())
  tenantId        String
  baseCurrency    String
  quoteCurrency   String
  rate            Decimal            @db.Decimal(24, 12)
  effectiveAt     DateTime
  expiresAt       DateTime?
  source          ExchangeRateSource
  sourceReference String?
  isOfficial      Boolean            @default(false)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  @@unique([tenantId, baseCurrency, quoteCurrency, effectiveAt])
  @@index([tenantId, baseCurrency, quoteCurrency, effectiveAt])
}

model AuditEvent {
  id           String         @id @default(cuid())
  tenantId     String?
  userId       String?
  actorType    AuditActorType
  actorId      String?
  actorLabel   String?
  action       String
  resourceType String
  resourceId   String?
  outcome      AuditOutcome   @default(SUCCESS)
  reason       String?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  before       Json?
  after        Json?
  metadata     Json?
  occurredAt   DateTime       @default(now())
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user         User?          @relation("AuditEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([userId, occurredAt])
  @@index([action, occurredAt])
}

model AiAgent {
  id                    String          @id @default(cuid())
  tenantId              String
  key                   String
  name                  String
  description           String?
  status                AiAgentStatus   @default(DRAFT)
  autonomyLevel         AiAutonomyLevel @default(ADVISORY)
  modelProvider         String?
  modelName             String?
  systemInstructions    String?
  allowedCapabilities   String[]
  restrictedActions     String[]
  humanApprovalRequired Boolean         @default(true)
  riskTier              Int             @default(1)
  configuration         Json?
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks                 AiAgentTask[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, status])
}

model PurchaseRequest {
  id                    String                    @id @default(cuid())
  tenantId              String
  requesterId           String
  legalEntityId         String?
  siteId                String?
  departmentId          String?
  requestNumber         String
  title                 String
  businessJustification String
  priority              PurchaseRequestPriority   @default(NORMAL)
  status                PurchaseRequestStatus     @default(DRAFT)
  neededByDate          DateTime?
  originalCurrency      String                    @default("USD")
  totalAmount           Decimal                   @db.Decimal(18, 2)
  usdEquivalent         Decimal                   @db.Decimal(18, 2)
  exchangeRateToUsd     Decimal                   @db.Decimal(24, 12)
  exchangeRateSource    String
  exchangeRateDate      DateTime
  submittedAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  revision              Int                       @default(1)
  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester             User                      @relation("PurchaseRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  legalEntity           LegalEntity?              @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  site                  Site?                     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  department            Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lines                 PurchaseRequestLine[]
  approvals             PurchaseRequestApproval[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  purchaseOrders        PurchaseOrder[]

  @@unique([tenantId, requestNumber])
  @@index([tenantId, status, createdAt])
  @@index([requesterId, status])
  @@index([legalEntityId])
  @@index([siteId])
  @@index([departmentId])
}

model PurchaseRequestLine {
  id                 String          @id @default(cuid())
  purchaseRequestId  String
  lineNumber         Int
  description        String
  category           String?
  quantity           Decimal         @db.Decimal(18, 4)
  unitOfMeasure      String
  unitPrice          Decimal         @db.Decimal(18, 4)
  lineTotal          Decimal         @db.Decimal(18, 2)
  supplierSuggestion String?
  purchaseRequest    PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([purchaseRequestId, lineNumber])
  @@index([purchaseRequestId])
}

model PurchaseRequestApproval {
  id                String           @id @default(cuid())
  purchaseRequestId String
  approverId        String
  sequence          Int
  decision          ApprovalDecision @default(PENDING)
  comments          String?
  decidedAt         DateTime?
  purchaseRequest   PurchaseRequest  @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  approver          User             @relation("PurchaseRequestApprover", fields: [approverId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([purchaseRequestId, approverId, sequence])
  @@index([approverId, decision])
  @@index([purchaseRequestId, sequence])
}

model Supplier {
  id                  String                      @id @default(cuid())
  tenantId            String
  supplierNumber      String
  legalName           String
  tradingName         String?
  countryCode         String
  taxIdentificationNo String?
  website             String?
  primaryEmail        String?
  primaryPhone        String?
  categories          String[]
  status              SupplierStatus              @default(PROSPECT)
  riskTier            SupplierRiskTier            @default(MODERATE)
  qualificationStatus SupplierQualificationStatus @default(NOT_STARTED)
  diversityOwned      Boolean                     @default(false)
  esgCommitted        Boolean                     @default(false)
  sanctionsScreenedAt DateTime?
  approvedAt          DateTime?
  suspendedAt         DateTime?
  rejectionReason     String?
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts            SupplierContact[]
  documents           SupplierDocument[]
  sourcingInvitations SourcingInvitation[]
  sourcingResponses   SourcingResponse[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  sourcingQuestions   SourcingQuestion[]
  contracts           Contract[]
  riskAssessments     SupplierRiskAssessment[]
  riskFindings        SupplierRiskFinding[]
  esgAssessments      SupplierEsgAssessment[]
  purchaseOrders      PurchaseOrder[]
  supplierInvoices    SupplierInvoice[]

  @@unique([tenantId, supplierNumber])
  @@unique([tenantId, legalName, countryCode])
  @@index([tenantId, status])
  @@index([tenantId, riskTier])
  @@index([tenantId, qualificationStatus])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
}

model SupplierDocument {
  id              String                 @id @default(cuid())
  supplierId      String
  type            SupplierDocumentType
  status          SupplierDocumentStatus @default(PENDING_VERIFICATION)
  name            String
  blobPathname    String?
  storageUrl      String?
  contentType     String?
  sizeBytes       Int?
  issuedAt        DateTime?
  expiresAt       DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  supplier        Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([supplierId, type])
  @@index([supplierId, status])
  @@index([expiresAt])
}

model SourcingEvent {
  id                  String               @id @default(cuid())
  tenantId            String
  eventNumber         String
  type                SourcingEventType
  status              SourcingEventStatus  @default(DRAFT)
  title               String
  summary             String
  scopeOfWork         String
  currencyCode        String               @default("USD")
  estimatedValue      Decimal?             @db.Decimal(18, 2)
  responseDeadline    DateTime?
  sealedResponses     Boolean              @default(true)
  allowMultipleRounds Boolean              @default(false)
  currentRound        Int                  @default(1)
  publishedAt         DateTime?
  awardedAt           DateTime?
  awardedSupplierId   String?
  awardRecommendation String?
  awardConfidence     Int?
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criteria            SourcingCriterion[]
  invitations         SourcingInvitation[]
  responses           SourcingResponse[]
  award               SourcingAward?
  evaluators          SourcingEvaluator[]
  rounds              SourcingRound[]
  questions           SourcingQuestion[]
  attachments         SourcingAttachment[]
  sealedBidOpening    SealedBidOpening?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([tenantId, eventNumber])
  @@index([tenantId, status, createdAt])
}

model SourcingCriterion {
  id              String                @id @default(cuid())
  sourcingEventId String
  name            String
  description     String?
  type            SourcingCriterionType
  weight          Int
  sequence        Int
  event           SourcingEvent         @relation(fields: [sourcingEventId], references: [id], onDelete: Cascade)
  scores          SourcingScore[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([sourcingEventId, sequence])
}

model SourcingInvitation {
  id              String                   @id @default(cuid())
  sourcingEventId String
  supplierId      String
  status          SourcingInvitationStatus @default(INVITED)
  invitedAt       DateTime                 @default(now())
  viewedAt        DateTime?
  submittedAt     DateTime?

  accessTokenHash String?       @unique
  accessExpiresAt DateTime?
  accessRevokedAt DateTime?
  event           SourcingEvent @relation(fields: [sourcingEventId], references: [id], onDelete: Cascade)
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([sourcingEventId, supplierId])
}

model SourcingResponse {
  id                String                 @id @default(cuid())
  sourcingEventId   String
  supplierId        String
  round             Int                    @default(1)
  status            SourcingResponseStatus @default(DRAFT)
  currencyCode      String                 @default("USD")
  totalBid          Decimal?               @db.Decimal(18, 2)
  deliveryDays      Int?
  paymentTerms      String?
  technicalResponse String?
  commercialNotes   String?
  submittedAt       DateTime?
  event             SourcingEvent          @relation(fields: [sourcingEventId], references: [id], onDelete: Cascade)
