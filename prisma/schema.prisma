  updatedAt             DateTime        @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, status])
}

model PurchaseRequest {
  id                    String                    @id @default(cuid())
  tenantId              String
  requesterId           String
  legalEntityId         String?
  siteId                String?
  departmentId          String?
  requestNumber         String
  title                 String
  businessJustification String
  priority              PurchaseRequestPriority   @default(NORMAL)
  status                PurchaseRequestStatus     @default(DRAFT)
  neededByDate          DateTime?
  originalCurrency      String                    @default("USD")
  totalAmount           Decimal                   @db.Decimal(18, 2)
  usdEquivalent         Decimal                   @db.Decimal(18, 2)
  exchangeRateToUsd     Decimal                   @db.Decimal(24, 12)
  exchangeRateSource    String
  exchangeRateDate      DateTime
  submittedAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  revision              Int                       @default(1)
  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester             User                      @relation("PurchaseRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  legalEntity           LegalEntity?              @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  site                  Site?                     @relation(fields: [siteId], references: [id], onDelete: SetNull)
