  approver          User             @relation("PurchaseRequestApprover", fields: [approverId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([purchaseRequestId, approverId, sequence])
  @@index([approverId, decision])
  @@index([purchaseRequestId, sequence])
}

model Supplier {
  id                       String                            @id @default(cuid())
