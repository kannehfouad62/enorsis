  @@unique([tenantId, legalName, countryCode])
  @@index([tenantId, status])
  @@index([tenantId, riskTier])
  @@index([tenantId, qualificationStatus])
  @@index([tenantId, isTenantSelfProfile])
}

model SupplierContact {
