  updatedAt                  DateTime                          @updatedAt
  isTenantSelfProfile        Boolean                           @default(false)
  sourcingQuestions          SourcingQuestion[]
  contracts                  Contract[]
  riskAssessments            SupplierRiskAssessment[]
  riskFindings               SupplierRiskFinding[]
  esgAssessments             SupplierEsgAssessment[]
  purchaseOrders             PurchaseOrder[]
